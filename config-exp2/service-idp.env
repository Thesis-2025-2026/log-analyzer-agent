# Service IdP Configuration - Identity Provider Service Agent Cluster

# Service Identity
SERVICE_NAME=idp-service
SERVICE_URL=http://service-idp-api:8000
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=IdP Service Agent - Analyzes identity provider and OAuth health logs
SERVICE_CAPABILITIES=idp,oauth,identity,provider

# Proxy Configuration
PROXY_URL=http://proxy:8000
PROXY_ENABLED=true
HEARTBEAT_INTERVAL=30
REGISTRATION_RETRY=10

# Database Configuration (Service-specific PostgreSQL)
DATABASE_URL=postgresql://logs_user:logs_pass@service-idp-postgres:5432/idp_logs
POSTGRES_HOST=service-idp-postgres
POSTGRES_PORT=5432
POSTGRES_DB=idp_logs
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass

# Qdrant Configuration (Service-specific vector DB)
QDRANT_URL=http://service-idp-qdrant:6333
QDRANT_COLLECTION=idp_log_fixes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cross-Service Configuration
CROSS_SERVICE_TIMEOUT=240

# Logging
LOG_LEVEL=INFO

# Model
MODEL_NAME=gpt-5-nano
MODEL_PLATFORM=OPENAI
