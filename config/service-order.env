# Service Order Configuration - Order Service Agent Cluster
# This service handles order-related log analysis

# Service Identity
SERVICE_NAME=order-service
SERVICE_URL=http://service-order-api:8000
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Order Service Agent - Analyzes order processing logs and errors
SERVICE_CAPABILITIES=order,fulfillment,inventory,shipping

# Proxy Configuration
PROXY_URL=http://proxy:8000
PROXY_ENABLED=true
HEARTBEAT_INTERVAL=30
REGISTRATION_RETRY=10

# Database Configuration (Service-specific PostgreSQL)
DATABASE_URL=postgresql://logs_user:logs_pass@service-order-postgres:5432/order_logs
POSTGRES_HOST=service-order-postgres
POSTGRES_PORT=5432
POSTGRES_DB=order_logs
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass

# Qdrant Configuration (Service-specific vector DB)
QDRANT_URL=http://service-order-qdrant:6333
QDRANT_COLLECTION=order_log_fixes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cross-Service Configuration
CROSS_SERVICE_TIMEOUT=240

# Logging
LOG_LEVEL=INFO

# Model
MODEL_NAME=gpt-5-nano
MODEL_PLATFORM=OPENAI
