# Service Auth Configuration - Auth Service Agent Cluster

# Service Identity
SERVICE_NAME=auth-service
SERVICE_URL=http://service-auth-api:8000
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Auth Service Agent - Analyzes authentication-related logs and errors
SERVICE_CAPABILITIES=auth,login,oauth,identity

# Proxy Configuration
PROXY_URL=http://proxy:8000
PROXY_ENABLED=true
HEARTBEAT_INTERVAL=30
REGISTRATION_RETRY=10

# Database Configuration (Service-specific PostgreSQL)
DATABASE_URL=postgresql://logs_user:logs_pass@service-auth-postgres:5432/auth_logs
POSTGRES_HOST=service-auth-postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_logs
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass

# Qdrant Configuration (Service-specific vector DB)
QDRANT_URL=http://service-auth-qdrant:6333
QDRANT_COLLECTION=auth_log_fixes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cross-Service Configuration
CROSS_SERVICE_TIMEOUT=240

# Logging
LOG_LEVEL=INFO

# Model
MODEL_NAME=gpt-4o
MODEL_PLATFORM=OPENAI
