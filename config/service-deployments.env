# Service Deployments Configuration - Deployments Service Agent Cluster

# Service Identity
SERVICE_NAME=deployments-service
SERVICE_URL=http://service-deployments-api:8000
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Deployments Service Agent - Analyzes deployment-related logs and errors
SERVICE_CAPABILITIES=deployments,release,rollback,ci-cd

# Proxy Configuration
PROXY_URL=http://proxy:8000
PROXY_ENABLED=true
HEARTBEAT_INTERVAL=30
REGISTRATION_RETRY=10

# Database Configuration (Service-specific PostgreSQL)
DATABASE_URL=postgresql://logs_user:logs_pass@service-deployments-postgres:5432/deployments_logs
POSTGRES_HOST=service-deployments-postgres
POSTGRES_PORT=5432
POSTGRES_DB=deployments_logs
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass

# Qdrant Configuration (Service-specific vector DB)
QDRANT_URL=http://service-deployments-qdrant:6333
QDRANT_COLLECTION=deployments_log_fixes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cross-Service Configuration
CROSS_SERVICE_TIMEOUT=240

# Logging
LOG_LEVEL=INFO
