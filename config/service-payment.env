# Service Payment Configuration - Payment Service Agent Cluster
# This service handles payment-related log analysis

# Service Identity
SERVICE_NAME=payment-service
SERVICE_URL=http://service-payment-api:8000
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Payment Service Agent - Analyzes payment-related logs and errors
SERVICE_CAPABILITIES=payment,billing,transaction,financial

# Proxy Configuration
PROXY_URL=http://proxy:8000
PROXY_ENABLED=true
HEARTBEAT_INTERVAL=30
REGISTRATION_RETRY=10

# Database Configuration (Service-specific PostgreSQL)
DATABASE_URL=postgresql://logs_user:logs_pass@service-payment-postgres:5432/payment_logs
POSTGRES_HOST=service-payment-postgres
POSTGRES_PORT=5432
POSTGRES_DB=payment_logs
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass

# Qdrant Configuration (Service-specific vector DB)
QDRANT_URL=http://service-payment-qdrant:6333
QDRANT_COLLECTION=payment_log_fixes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cross-Service Configuration
CROSS_SERVICE_TIMEOUT=240

# Logging
LOG_LEVEL=INFO
