create a .env file on the root dir and paste the contents of this file in to the .env file

# Local LLM via Ollama (OpenAI-compatible)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL_NAME=phi3:mini

# Postgres
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass
POSTGRES_DB=logs_db


# Redis / PubSub
# Redis connection for detector and filters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Pub/Sub channels
LOGS_CHANNEL=logs
ANOM_CHANNEL=anomalies

# Similarity filter (dedup) settings
# Time window in seconds to remember similar patterns
SIM_TTL_SEC=600
# Key prefix used in Redis for similarity fingerprints
SIM_NAMESPACE=det:sim
