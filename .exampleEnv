# Local LLM via Ollama (OpenAI-compatible)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_NAME=phi3:mini

# For running agents using Open AI API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
MODEL_NAME=gpt-5-mini-2025-08-07

# OpenAI Embeddings (for vector database)
# Set these to use OpenAI's text-embedding-3-small model
# If not set, will fall back to OPENAI_BASE_URL and OPENAI_API_KEY
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_API_KEY=sk-your-openai-api-key-here

# Postgres
POSTGRES_USER=logs_user
POSTGRES_PASSWORD=logs_pass
POSTGRES_DB=logs_db


# Redis / PubSub
# Redis connection for detector and filters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Pub/Sub channels
LOGS_CHANNEL=logs
ANOM_CHANNEL=anomalies

# Similarity filter (dedup) settings
# Time window in seconds to remember similar patterns
SIM_TTL_SEC=600
# Key prefix used in Redis for similarity fingerprints
SIM_NAMESPACE=det:sim
# Vector DB
QDRANT_URL=xxxxxxxxxxxxxxxxxxxx
QDRANT_API_KEY=xxxxxxxxxxxxxxxxx
QDRANT_COLLECTION=log_fixes
EMBEDDING_DIM=1536